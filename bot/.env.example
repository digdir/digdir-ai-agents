# Copy this file to .env and fill in the values. .env is gitignored.

# ---------------------------------------------------------------------------
# GitHub connector
# ---------------------------------------------------------------------------
# Set to "true" to enable polling GitHub notifications for the token's user.
GITHUB_ENABLED=true

# Token for issue/PR actions (unassign self, add reactions). A fine-grained PAT
# works here: Read+Write to "Issues" and "Pull requests" on the target repos.
# A classic PAT with `repo` also works.
GITHUB_TOKEN=

# Token for the notifications API (listing + marking read). The notifications API
# does NOT work with fine-grained PATs, so this must be a CLASSIC PAT with the
# `notifications` scope.
#
# The two tokens fall back to each other, so you can set just one: a single
# CLASSIC PAT with `repo` + `notifications` scopes works for everything — put it
# in either variable and leave the other blank.
GITHUB_TOKEN_CLASSIC_NOTIFICATIONS=

# Emoji used to acknowledge an @-mention when NO answer is posted back
# (queue bridge off, or AGENT_POST_RESULTS=false).
# One of GitHub's allowed reactions: +1 -1 laugh confused heart hooray rocket eyes
GITHUB_REACTION=rocket

# "Working…" reaction shown while the agent runs, removed once it has answered
# (only when the queue bridge posts answers back). GitHub has no thinking_face,
# so "eyes" is the natural choice. Must be one of the allowed reactions above.
GITHUB_WORKING_REACTION=eyes

# Reaction added when the agent classifies the input as a pure "ack" (no reply
# is posted). Must be one of GitHub's allowed reactions above.
GITHUB_ACK_REACTION=+1

# Minimum seconds between notification polls. GitHub also sends an X-Poll-Interval
# header which is always respected as a lower bound.
GITHUB_POLL_INTERVAL=60

# API base URL. Change for GitHub Enterprise Server (e.g. https://ghe.example.com/api/v3).
GITHUB_API_URL=https://api.github.com

# ---------------------------------------------------------------------------
# Slack connector (Socket Mode — no public endpoint required)
# ---------------------------------------------------------------------------
SLACK_ENABLED=true

# App-level token (starts with xapp-). Requires the `connections:write` scope and
# Socket Mode enabled in the Slack app settings.
SLACK_APP_TOKEN=

# Bot token (starts with xoxb-). Required scopes:
#   - reactions:write  (add the reaction)
#   - users:write      (set active/away presence on start/stop)
#   - history scopes for the surfaces you want to listen to:
#     channels:history / groups:history / im:history / mpim:history
# Subscribe to the matching message.* events under Event Subscriptions.
SLACK_BOT_TOKEN=

# Reaction used to acknowledge a message when NO answer is posted back (queue
# bridge off, or AGENT_POST_RESULTS=false). Emoji name, no colons.
# Alternatives if your workspace lacks shrug: man-shrugging, woman-shrugging.
SLACK_REACTION=shrug

# "Working…" reaction shown while the agent runs, removed once it has answered
# (only when the queue bridge posts answers back).
SLACK_WORKING_REACTION=thinking_face

# Reaction added when the agent classifies the input as a pure "ack" (no reply
# is posted). Emoji name, no colons.
SLACK_ACK_REACTION=white_check_mark

# ---------------------------------------------------------------------------
# Agent queue bridge (hands events off to dd-agent and posts answers back)
# ---------------------------------------------------------------------------
# When enabled, events (Slack messages that reach the bot, GitHub @-mentions)
# are appended to dd-agent's inbox.jsonl. The bot then polls results.jsonl and
# posts each answer back to the originating Slack thread / GitHub issue. The
# emoji reactions above still fire as a quick "received" acknowledgement.
AGENT_QUEUE_ENABLED=false

# Path to dd-agent's shared `triggers/` directory (both apps run on the same
# machine). The bot writes inbox.jsonl and reads results.jsonl + logs/ here.
AGENT_TRIGGERS_DIR=../agents/dd-agent/triggers

# Where the bot keeps its own state (pending replies + results read-offset).
# Survives restarts so an answer is still delivered if the bot was restarted
# between submitting an event and the result arriving.
AGENT_STATE_DIR=.state

# Set to false to only submit events and skip posting answers back.
AGENT_POST_RESULTS=true

# Seconds between checks of results.jsonl.
AGENT_RESULTS_POLL_INTERVAL=5

# Answers longer than this many characters are truncated before posting.
AGENT_MAX_REPLY_CHARS=12000
